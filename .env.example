# Documentation-only example. The Android app stores these settings through its
# PIN-protected administrator menu; it does not read this file at runtime.
SPOTIFY_CLIENT_ID=YOUR_PUBLIC_SPOTIFY_CLIENT_ID
SPOTIFY_REDIRECT_URI=http://127.0.0.1:25566/callback
PREFERRED_SPOTIFY_DEVICE_NAME=YOUR_WINDOWS_PC_NAME

# Never add SPOTIFY_CLIENT_SECRET. This mobile app uses PKCE and has no secret.
